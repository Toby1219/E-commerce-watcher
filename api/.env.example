# FOR DOCKER USAGE
# listen on all interfaces so Docker's port mapping can reach the app
BIND_ADDRESS=0.0.0.0
# origin of the frontend (browser side, so localhost is correct here)
CORS_ORIGIN=http://localhost:5173
# port the app listens on inside the container
PORT_NUMBER=8181
# host = compose service "db", port = container port 5432 (not 5433)
DATABASE_URL=postgres://docker_user:dockeruser001@db:5432/e_watchdb
# host = compose service "redis"
REDIS_URL=redis://redis:6379
# placeholder secret, replace with a real one
SECRET_KEY=your_secret_key_here
# print backtraces on panic
RUST_BACKTRACE=1
# log verbosity
RUST_LOG=debug
# host = compose service "internal_api", container port 8000
PY_API_HOST=http://internal_api:8000

