# FOR DOCKER USAGE 
# database credentials, must match the root .env
DB_USER=docker_user
DB_PASSWORD=dockeruser001
# compose service name of Postgres
DB_HOST=db
# container port, not the host-mapped one
DB_PORT=5432
# NOTE: your original had a stray trailing quote (e_watchdb") which becomes part of the name
DB_NAME=e_watchdb
# exchange-rate endpoint (see key warning below)
CURRENCY_API_URL=https://v6.exchangerate-api.com/v6/YOUR_KEY/latest/USD
# allowed CORS origins
ORIGINS=[http://localhost:8080, http://127.0.0.1:8080, http://localhost:8181, http://127.0.0.1:8181]
